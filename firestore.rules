rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per class (created by the faculty admin panel).
    match /classes/{classId} {
      allow read, write: if request.auth != null;

      match /students/{rollNo} {
        allow read, write: if request.auth != null;
      }
    }

    // Single doc holding the faculty passcode (set on first admin visit).
    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}

// NOTE ON SECURITY (read this before going live):
// Every visitor — student or faculty — signs in anonymously to Firebase Auth
// so these rules can require request.auth != null. There is no Cloud Functions
// backend in this build, so the class/roll-no/password check happens entirely
// in the browser after reading the student's document. That means any signed-in
// (anonymous) client can technically read or write any class's data if they
// know or guess the class code. This is appropriate for a low-stakes classroom
// practice quiz, but:
//   - Do NOT reuse real/sensitive passwords for student logins.
//   - Do NOT store any sensitive personal data beyond name + roll number.
//   - Pick non-guessable class codes if you want extra privacy between sections.
// For stronger security later, add Firebase Cloud Functions with custom auth
// claims (requires the pay-as-you-go "Blaze" plan, still free at this scale).
